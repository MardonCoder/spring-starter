<?xml version="1.0" encoding="UTF-8" ?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="driver" class="java.lang.String">
        <constructor-arg type="java.lang.String" value="PostgresDriver"/>
    </bean>

    <bean id="pool1" name="p1,poo1,pl1" class="org.mardon.spring.database.pool.ConnectionPool"
          init-method="init"
          destroy-method="destroy"
          scope="singleton">
        <constructor-arg index="0" type="java.lang.String" ref="driver"/>
        <constructor-arg index="1" type="java.lang.Integer" value="10"/>
        <constructor-arg index="2" type="java.util.List"> <!-- также можно указывать name вместо index -->
            <list>
                <value>--arg1=value1</value>
                <value>--arg2=value2</value>
                <ref bean="driver"/>
            </list>
        </constructor-arg>
        <constructor-arg index="3" type="java.util.Map">
            <null/>
        </constructor-arg>
        <property name="properties">
            <map>
                <entry key="url" value="postgresurl"/>
                <entry key="password" value="123"/>
                <entry key="driver" value-ref="driver"/> <!-- айди нашего бина -->
            </map>
        </property>
    </bean>

    <bean id="companyRepository" class="org.mardon.spring.database.repository.CompanyRepository" factory-method="of">
        <constructor-arg ref="p1"/>
    </bean>
<!--    <bean id="pool2" class="org.mardon.spring.database.pool.ConnectionPool"/>-->

</beans>